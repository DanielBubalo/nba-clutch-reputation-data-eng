# Copy this file to .env and fill in the values.
# Set to the output of: id -u
AIRFLOW_UID=50000
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
# Optional: lets the pipeline agent write failure reports. Leave empty to turn that off.
ANTHROPIC_API_KEY=
# Optional: run Airflow on the live environment (see "Live Data and Environments" in the README).
# NBA_DB_FILE=live/nba_clutch_live.duckdb
# NBA_CACHE_FOLDER=live/cached_data
# Optional, live environment only: a daily run at 14:00 UTC.
# NBA_PIPELINE_SCHEDULE="0 14 * * *"